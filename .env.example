# Public domain – the MCP host becomes portainer-mcp.${DOMAIN}.
# Used by the Traefik labels in docker-compose.yml.
DOMAIN=example.com

# External Docker network of your Portainer stack. Used so this container
# can reach Portainer at http://portainer:9000. Default matches a stock
# `docker compose up -d` deployment.
PORTAINER_NETWORK=portainer_default

# ---------------------------------------------------------------------------
# Portainer connection
# ---------------------------------------------------------------------------
# Internal URL works best when the MCP container shares a Docker network
# with Portainer. Otherwise use the public https URL.
PORTAINER_URL=http://portainer:9000
PORTAINER_TOKEN=ptr_xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# MCP auth
# ---------------------------------------------------------------------------
# Static fallback Bearer token. Useful for Claude Desktop / direct tooling.
# Optional – leave empty if you only use OIDC.
MCP_API_KEY=

# Authelia OIDC token introspection (RFC 7662). Required for the
# Claude.ai OAuth flow. The internal URL works best when Authelia
# shares the traefik network with the MCP container.
OIDC_INTROSPECTION_URL=http://authelia:9091/api/oidc/introspection
OIDC_CLIENT_ID=portainer-mcp
# Plaintext secret. Authelia stores its bcrypt hash; the MCP server
# needs the plaintext so it can authenticate against the introspection
# endpoint with HTTP Basic auth.
OIDC_CLIENT_SECRET=changeme

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# trace | debug | info (default) | warn | error
# At debug or below, logs are pretty-printed for `docker logs`.
LOG_LEVEL=info
