# Domain (used by Traefik labels)
DOMAIN=example.com

# Portainer connection
PORTAINER_URL=https://portainer.example.com
PORTAINER_TOKEN=ptr_xxxxxxxxxxxx

# MCP auth – static fallback Bearer token (Claude Desktop)
MCP_API_KEY=changeme

# Authelia OIDC – Token Introspection (Claude.ai OAuth flow)
# Use the internal Docker URL when authelia is on the same network:
OIDC_INTROSPECTION_URL=http://authelia:9091/api/oidc/introspection
OIDC_CLIENT_ID=portainer-mcp
OIDC_CLIENT_SECRET=changeme
